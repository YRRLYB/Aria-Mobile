<?xml version="1.0" encoding="utf-8"?>
<!--
  Aria mobile talks to the desktop backend over plain HTTP on the LAN
  (e.g. http://192.168.x.x:3636). Cleartext is required for that pairing;
  traffic is protected by a per-install pairing token instead of TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
